{
  "devices": [
    {
      "id": "webcam-high",
      "name": "Logitech C920 (High Res)",
      "type": "video",
      "ffmpeg_input": "/dev/video0",
      "ffmpeg_args": [
        "-f",
        "v4l2",
        "-framerate",
        "30",
        "-video_size",
        "1920x1080"
      ],
      "output_codec": "libx264",
      "output_args": [
        "-preset",
        "ultrafast",
        "-tune",
        "zerolatency",
        "-f",
        "h264"
      ]
    },
    {
      "id": "system-audio",
      "name": "Desktop Audio (PipeWire Monitor)",
      "type": "audio",
      "ffmpeg_input": "default",
      "ffmpeg_args": [
        "-f",
        "pulse",
        "-i",
        "alsa_output.pci-0000_00_1f.3.analog-stereo.monitor"
      ],
      "output_codec": "libopus",
      "output_args": [
        "-b:a",
        "128k",
        "-f",
        "opus"
      ]
    }
  ]
}
